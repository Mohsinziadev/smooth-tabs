{
    "name": "smooth-tabs",
    "version": "5.0.1",
    "description": "Accessible, scrollable React tabs with an animated indicator, overflow-aware arrows, keyboard navigation and built-in scroll-spy for section navigation. Zero dependencies.",
    "keywords": [
        "react",
        "react-smooth-tabs",
        "tabs",
        "react-tabs",
        "scrollable-tabs",
        "horizontal-scroll",
        "tab-bar",
        "tablist",
        "scrollspy",
        "scroll-spy",
        "sticky-nav",
        "category-nav",
        "accessible",
        "a11y",
        "wai-aria",
        "keyboard-navigation",
        "rtl",
        "typescript",
        "react-component"
    ],
    "homepage": "https://smooth-tabs.vercel.app/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Mohsinziadev/smooth-tabs.git"
    },
    "bugs": {
        "url": "https://github.com/Mohsinziadev/smooth-tabs/issues"
    },
    "license": "ISC",
    "author": "Mohsin Zia <mohsinziadev@gmail.com>",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./styles.css": "./dist/styles.css",
        "./dist/index.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "vite demo",
        "demo:build": "vite build demo",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:compat": "node scripts/compat.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:package": "publint --strict && attw --pack . --exclude-entrypoints styles.css dist/index.css",
        "size": "node scripts/size.mjs",
        "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run check:package && npm run size",
        "prepublishOnly": "npm run verify",
        "prepare": "husky install"
    },
    "peerDependencies": {
        "react": ">=16.8.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.2",
        "@eslint/js": "^9.39.0",
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.0",
        "@types/react": "^18.3.20",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^9.39.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.5.0",
        "husky": "^8.0.3",
        "jsdom": "^26.1.0",
        "lint-staged": "^17.6.0",
        "prettier": "^2.8.8",
        "publint": "^0.3.12",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tsup": "^8.5.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.46.0",
        "vite": "^6.4.0",
        "vitest": "^5.0.5"
    },
    "lint-staged": {
        "*.{js,mjs,ts,tsx,css,md,json}": "prettier --write"
    }
}
